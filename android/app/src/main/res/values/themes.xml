<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent: the biometric library shows AppCompat dialogs (fingerprint fallback),
         which crash the app under a plain framework theme. -->
    <style name="Theme.TWMG" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
