<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat parent: the biometric library shows AppCompat dialogs (fingerprint fallback),
         which crash the app under a plain framework theme. -->
    <style name="Theme.TWMG" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/background</item>
        <item name="colorPrimary">@color/brand</item>
        <item name="colorAccent">@color/brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Shown by the system before the app's first frame; hands over to StartupView. -->
    <style name="Theme.TWMG.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/brand</item>
        <item name="postSplashScreenTheme">@style/Theme.TWMG</item>
    </style>
</resources>
